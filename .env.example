# ── Twitter/X ─────────────────────────────────────────────────────────────────
# Créer une app sur https://developer.twitter.com/
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Compte à surveiller (sans @)
TARGET_USERNAME=Kekius_Sage

# ── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=         # Clé privée base58 de ton wallet
SOLANA_BUY_AMOUNT=0.1       # Montant en SOL par achat
SOLANA_SLIPPAGE_BPS=1000    # 10% de slippage (1000 bps)

# ── Ethereum / EVM ───────────────────────────────────────────────────────────
ETH_RPC_URL=https://eth.llamarpc.com
ETH_PRIVATE_KEY=            # Clé privée hex (avec 0x)
ETH_BUY_AMOUNT_ETH=0.05     # Montant en ETH par achat
ETH_SLIPPAGE_PCT=15         # 15% de slippage

# ── Filtres de sécurité ──────────────────────────────────────────────────────
MIN_LIQUIDITY_USD=5000      # Liquidité minimale en USD
MAX_BUY_TAX_PCT=10          # Tax de buy maximale autorisée (%)
REQUIRE_RENOUNCED=false     # Exiger que l'ownership soit renoncé

# ── Monitoring ───────────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=60        # Intervalle en secondes si mode polling
USE_STREAMING=true          # true = streaming temps réel, false = polling
LOG_LEVEL=INFO
